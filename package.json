{
  "name": "mosaiq",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @mosaiq/shared build && pnpm --filter @mosaiq/database build && pnpm --parallel --filter @mosaiq/api --filter @mosaiq/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @mosaiq/database db:generate",
    "db:migrate": "pnpm --filter @mosaiq/database db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
