DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mosaiq
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
# Optional when the web app and API are served from different origins.
VITE_API_URL=
# Private owner access. Generate the hash with: pnpm auth:hash-password
AUTH_OWNER_USERNAME=owner
AUTH_OWNER_PASSWORD_HASH=
AUTH_SESSION_TTL_HOURS=168
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
# Enable only when the API is directly behind one trusted reverse proxy.
API_TRUST_PROXY=false
STORAGE_ROOT=./storage
STORAGE_DRIVER=filesystem
# OCI Object Storage (used when STORAGE_DRIVER=oci)
OCI_AUTH_MODE=instance_principal
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_OBJECT_STORAGE_BUCKET=mosaiq-images
OCI_OBJECT_STORAGE_REGION=ap-hyderabad-1
OCI_OBJECT_STORAGE_PREFIX=mosaiq
# Only needed for local config-file authentication; leave blank on an OCI VM.
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT
MAX_UPLOAD_BYTES=26214400
MAX_IMAGE_PIXELS=80000000
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=60000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=120000
PROCESSING_WORKER_ENABLED=true
